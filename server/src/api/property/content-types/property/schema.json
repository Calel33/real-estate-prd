{
  "kind": "collectionType",
  "collectionName": "properties",
  "info": {
    "singularName": "property",
    "pluralName": "properties",
    "displayName": "Property",
    "description": "Real estate property listings"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "maxLength": 255,
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "location": {
      "type": "string",
      "maxLength": 500
    },
    "acreage": {
      "type": "float"
    },
    "ft2": {
      "type": "biginteger"
    },
    "propertyType": {
      "type": "enumeration",
      "enum": [
        "residential",
        "commercial",
        "land",
        "ranch",
        "estate",
        "other"
      ]
    },
    "description": {
      "type": "blocks"
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "heroVideo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "videos"
      ]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "map": {
      "type": "json",
      "required": false
    },
    "plusCode": {
      "type": "string",
      "maxLength": 255,
      "required": false
    },
    "mapImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "propertyId": {
      "type": "string",
      "maxLength": 255
    },
    "ownership": {
      "type": "string",
      "default": "Fractional / Tokenized",
      "maxLength": 255
    },
    "status": {
      "type": "enumeration",
      "default": "draft",
      "enum": [
        "draft",
        "published"
      ]
    }
  }
}
