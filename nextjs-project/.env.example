# Strapi CMS
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=your-strapi-api-token-here

# Resend (email)
RESEND_API_KEY=re_your-api-key-here
RESEND_FROM_EMAIL=info@yourdomain.com
# Optional: separate address where admin notifications are sent
# Falls back to RESEND_FROM_EMAIL if not set.
# ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com

# Revalidation
# Must match Strapi's REVALIDATION_SECRET for webhook auth to succeed.
REVALIDATE_SECRET=your-revalidate-secret-here
